# Appwrite Cloud Configuration
# Get these from: https://cloud.appwrite.io/console/project-[id]/settings
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_APPWRITE_DATABASE_ID=dhivyuga_db
APPWRITE_API_KEY=your_api_key_here

# Admin route protection secret (set any strong random string)
ADMIN_API_SECRET=your_admin_secret_here
